<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VitalHubApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@color/vital_background</item>
        <item name="android:colorBackground">@color/vital_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.VitalHub.Activity</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.VitalHubApplication.Starting" parent="Theme.VitalHubApplication">
        <item name="android:windowBackground">@color/vital_background</item>
    </style>

    <style name="Animation.VitalHub.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/flow_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/flow_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/flow_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/flow_activity_close_exit</item>
    </style>
</resources>
